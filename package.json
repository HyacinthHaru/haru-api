{
  "name": "haru-api",
  "version": "0.1.0",
  "private": true,
  "description": "BMCLAPI-compatible scraper backend: syncs Minecraft/Forge/NeoForge/OptiFine/LiteLoader/Fabric/Quilt metadata from official sources into MongoDB and serves it with the BMCLAPI HTTP interface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "sync": "tsx src/cli.ts sync",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx test/e2e/consistency.ts",
    "import-optifine-history": "tsx scripts/import-optifine-history.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "mongodb": "^7.7.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
