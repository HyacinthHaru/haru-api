HOST=0.0.0.0
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/haru-api

# token for POST /_haru/sync/:task
ADMIN_TOKEN=

# sync tasks to schedule and whether to run them at startup
SYNC_TASKS=mojang,java,forge,neoforge,optifine,liteloader,fabric,authlib-injector
SYNC_ON_START=true
# per-task interval in minutes, e.g.
# SYNC_INTERVAL_MOJANG=10
# SYNC_INTERVAL_FORGE=30
# SYNC_INTERVAL_AUTHLIB_INJECTOR=360

HTTP_CONCURRENCY=8
HTTP_TIMEOUT_MS=60000
HTTP_RETRIES=3

# seconds metadata fetched on demand (fabric-meta, neoforge/meta, ...) is kept
META_CACHE_TTL=600

LOG_LEVEL=info

# upstream overrides (defaults are the official hosts), e.g.
# UPSTREAM_PISTON_META=https://piston-meta.mojang.com
# UPSTREAM_FORGE_MAVEN=https://maven.minecraftforge.net
